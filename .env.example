# OpenAI-compatible API (optional; only used when privacy mode permits remote generation)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Default privacy mode: LOCAL_ONLY | REMOTE_PROFILE_ONLY | REMOTE_EXEMPLARS
AUTHORSTYLE_PRIVACY_MODE=LOCAL_ONLY

# Profile data directory (default: ~/.authorstyle)
# AUTHORSTYLE_HOME=
